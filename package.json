{
  "name": "design-system-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turns websites, codebases and Figma files into linked tokens, components, Figma assets and docs.",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "source:fetch": "node --experimental-strip-types packages/discovery/src/cli/fetch-source.ts",
    "audit": "node --experimental-strip-types packages/discovery/src/cli/audit.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "render": "node --experimental-strip-types packages/discovery/src/cli/render.ts",
    "tokens": "node --experimental-strip-types packages/tokens/src/cli/tokens.ts",
    "catalog": "node --experimental-strip-types packages/catalog/src/cli/catalog.ts",
    "storybook": "npm run dev -w @dsa/storybook",
    "build-storybook": "npm run build -w @dsa/storybook",
    "test:docs": "node --experimental-strip-types tests/docs/check-storybook.ts",
    "test:parity": "node --experimental-strip-types tests/parity/button-parity.ts",
    "figma": "node --experimental-strip-types packages/gen-figma/src/cli/figma.ts",
    "studio": "npm run build -w @dsa/studio && npm run start -w @dsa/studio",
    "test:studio-ui": "node --experimental-strip-types tests/studio/smoke.ts",
    "build:figma-plugin": "node --experimental-strip-types --disable-warning=ExperimentalWarning apps/studio/figma-plugin/build.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
