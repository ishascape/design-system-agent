{
  "name": "design-system-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turns websites, codebases and Figma files into linked tokens, components, Figma assets and docs.",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "source:fetch": "node --experimental-strip-types packages/discovery/src/cli/fetch-source.ts",
    "audit": "node --experimental-strip-types packages/discovery/src/cli/audit.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "render": "node --experimental-strip-types packages/discovery/src/cli/render.ts",
    "tokens": "node --experimental-strip-types packages/tokens/src/cli/tokens.ts",
    "catalog": "node --experimental-strip-types packages/catalog/src/cli/catalog.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
